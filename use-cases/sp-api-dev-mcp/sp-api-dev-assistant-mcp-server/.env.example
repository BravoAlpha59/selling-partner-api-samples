# Local deployment config for docker-compose. Copy to .env and fill in.
#   cp .env.example .env
# .env is gitignored — real secrets belong there, never in docker-compose.yml.
#
# Leave everything commented out to run with auth OFF (the default).

# --- Auth: require a bearer token on /mcp -----------------------------------
# AUTH_ENABLED=1

# The OIDC issuer. MUST be https:// — openid-client rejects a plaintext issuer.
# Copy this EXACTLY from the `issuer` field of the provider's discovery doc:
#   <issuer>/.well-known/openid-configuration
# Authentik format: https://<host>/application/o/<application-slug>/
# OIDC_ISSUER=https://idp.example.ts.net:8943/application/o/sp-api-dev-assistant/

# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# Where the IdP sends the browser back. Must match the redirect URI registered
# with the provider EXACTLY. http:// is fine here (only the issuer must be TLS).
# OIDC_REDIRECT_URI=http://host.example.ts.net:3000/auth/callback

# This service's own base URL, used to build links on the token page.
# PUBLIC_URL=http://host.example.ts.net:3000

# --- Dev only: mint a token without an IdP (POST /auth/dev-login) -----------
# Never enable this on anything reachable by people you don't trust.
# AUTH_DEV_LOGIN=1
